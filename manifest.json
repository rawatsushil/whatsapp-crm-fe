{
  "manifest_version": 3,
  "name": "WhatsApp CRM",
  "version": "1.0.0",
  "description": "CRM sidebar for WhatsApp Web - organize chats, set reminders, and reply faster",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "config.js",
        "content/dom-utils.js",
        "content/chat-observer.js",
        "content/sidebar-injector.js"
      ],
      "css": [
        "content/sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "WhatsApp CRM"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/*",
        "content/page-script.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}